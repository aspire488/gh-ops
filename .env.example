# Copy to `.env` and fill in real values. `.env` is gitignored; never commit it.
# In GitHub Actions, use repository secrets instead; the process environment
# always takes precedence over `.env`.

# Telegram bot token (@BotFather). Read ONLY from this variable.
TELEGRAM_BOT_TOKEN=

# GitHub token. Classic PAT with `repo` (and `notifications`) scopes, or a
# fine-grained token with read access to the repos you care about.
# Write actions (always confirmation-gated) need write access to those repos.
GITHUB_TOKEN=

# LLM providers (OpenAI-compatible). Order = failover order.
GH_OPS_LLM_PROVIDERS=groq,gemini
GH_OPS_LLM_TIMEOUT_S=45
# A provider may list several models, comma-separated; each is its own
# failover step (Groq rate-limits per model, so this multiplies free quota).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional extra providers with built-in endpoints: cerebras, openrouter, nvidia, together
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=
